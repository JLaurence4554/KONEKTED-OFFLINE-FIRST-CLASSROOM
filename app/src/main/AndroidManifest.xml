<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- PHASE: online sync. android:usesCleartextTraffic="true" below allows
         plain-HTTP calls to the backend for local/XAMPP/ngrok-http testing
         (see backend/README.md). Remove it once the backend is deployed
         behind HTTPS — cleartext traffic should not ship in a production build. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ClassroomApp">

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.ClassroomApp.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.SignUpActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.dashboard.teacher.TeacherDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.dashboard.student.StudentDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.dashboard.student.MyClassesActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.classmanagement.teacher.CreateEditClassActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.classmanagement.teacher.ViewStudentsActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.lessons.LessonsListActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.lessons.teacher.CreateEditLessonActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.lessons.teacher.TeacherLessonDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.quiz.teacher.QuizListActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.quiz.teacher.CreateEditQuizActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.quiz.teacher.QuestionListActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.quiz.teacher.CreateEditQuestionActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.quiz.teacher.QuizResultsActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.quiz.teacher.EssayGradingActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.quiz.student.TakeQuizActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.quiz.student.QuizResultActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <!-- Offline Live Quiz -->
        <activity
            android:name=".ui.quiz.teacher.LiveSessionActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.quiz.student.JoinQuizActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.quiz.student.LocalQuizActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.notifications.JoinRequestsActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <activity
            android:name=".ui.lessons.student.LessonDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.ClassroomApp.NoActionBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
