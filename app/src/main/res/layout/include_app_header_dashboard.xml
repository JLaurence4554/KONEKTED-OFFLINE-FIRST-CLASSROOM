<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/header_height_dashboard"
    android:background="@drawable/bg_header_decorative"
    android:orientation="vertical"
    android:paddingStart="@dimen/header_padding_horizontal"
    android:paddingTop="@dimen/spacing_xs"
    android:paddingEnd="@dimen/header_padding_horizontal"
    android:paddingBottom="@dimen/spacing_sm">

    <!-- Top row: avatar / meta + notification bell -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Avatar + greeting block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/avatar_size_header"
                android:layout_height="@dimen/avatar_size_header"
                android:layout_marginEnd="@dimen/header_avatar_margin_end">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgHeaderAvatar"
                    android:layout_width="@dimen/avatar_size_header"
                    android:layout_height="@dimen/avatar_size_header"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                    app:strokeColor="@color/white"
                    app:strokeWidth="@dimen/avatar_border_width"
                    tools:ignore="ContentDescription"
                    tools:visibility="gone" />

                <TextView
                    android:id="@+id/txtHeaderInitials"
                    android:layout_width="@dimen/avatar_size_header"
                    android:layout_height="@dimen/avatar_size_header"
                    android:background="@drawable/bg_avatar_initials"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="L" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHeaderGreeting"
                    style="@style/HeaderGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Home" />

                <TextView
                    android:id="@+id/txtHeaderSubtitle"
                    style="@style/HeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Teacher" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notification bell -->
        <FrameLayout
            android:id="@+id/btnNotifications"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp">

            <ImageView
                android:id="@+id/imgNotificationBell"
                android:layout_width="@dimen/notification_icon_size"
                android:layout_height="@dimen/notification_icon_size"
                android:contentDescription="@string/notification_bell"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_notification_bell" />

            <TextView
                android:id="@+id/txtNotificationBadge"
                style="@style/NotificationBadge"
                android:layout_gravity="top|end"
                android:visibility="gone"
                tools:text="3"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
