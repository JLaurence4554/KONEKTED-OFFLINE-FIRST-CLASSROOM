<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_12sdp"
    android:layout_marginVertical="@dimen/_6sdp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/card_corner_large"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/outline_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_14sdp">

        <FrameLayout
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:background="@drawable/bg_circle_tertiary_light">

            <ImageView
                android:layout_width="@dimen/_20sdp"
                android:layout_height="@dimen/_20sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_quiz"
                android:contentDescription="Quiz"
                app:tint="@color/tertiary" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvQuizTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_12sdp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text"
            android:textSize="@dimen/_14sdp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Chapter 1 Quiz: Fractions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuizAction"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:fontFamily="sans-serif-medium"
            android:textSize="@dimen/_11sdp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="@dimen/_14sdp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/card_corner_medium"
            app:rippleColor="@color/primary"
            tools:text="Start" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
