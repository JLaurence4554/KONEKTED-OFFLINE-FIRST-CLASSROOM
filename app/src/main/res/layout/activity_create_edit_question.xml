<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/primary" android:elevation="0dp" android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar">
                <include
            android:id="@+id/appHeader"
            layout="@layout/include_app_header_sub"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height_sub" />
    </com.google.android.material.appbar.AppBarLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never" app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/header_height_sub" android:orientation="vertical" android:padding="@dimen/spacing_lg">
<com.google.android.material.card.MaterialCardView style="@style/Card.Standard" android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_xl">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_md" android:text="Question" android:textColor="@color/text_primary" android:textSize="@dimen/text_title_small" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_xs" android:text="@string/question_type_label" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption" />
<Spinner android:id="@+id/spinnerQuestionType" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_md" android:background="@drawable/bg_radio_choice" android:paddingHorizontal="@dimen/_14sdp" android:paddingVertical="@dimen/_10sdp" />
<com.google.android.material.textfield.TextInputLayout android:id="@+id/tilQuestionText" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/hint_question_text" app:boxCornerRadiusBottomEnd="@dimen/input_corner" app:boxCornerRadiusBottomStart="@dimen/input_corner" app:boxCornerRadiusTopEnd="@dimen/input_corner" app:boxCornerRadiusTopStart="@dimen/input_corner">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/etQuestionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:inputType="textMultiLine" android:minLines="2" />
</com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:id="@+id/cardMultipleChoice" style="@style/Card.Standard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_xl">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_xs" android:text="Answer Choices" android:textColor="@color/text_primary" android:textSize="@dimen/text_title_small" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_md" android:text="@string/label_correct_answer" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:gravity="center_vertical" android:orientation="horizontal">
<RadioButton android:id="@+id/radioA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/primary" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_sm" android:layout_weight="1" android:hint="@string/hint_choice_a" app:boxCornerRadiusBottomEnd="@dimen/card_corner_small" app:boxCornerRadiusBottomStart="@dimen/card_corner_small" app:boxCornerRadiusTopEnd="@dimen/card_corner_small" app:boxCornerRadiusTopStart="@dimen/card_corner_small">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/etChoiceA" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" />
</com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:gravity="center_vertical" android:orientation="horizontal">
<RadioButton android:id="@+id/radioB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/primary" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_sm" android:layout_weight="1" android:hint="@string/hint_choice_b" app:boxCornerRadiusBottomEnd="@dimen/card_corner_small" app:boxCornerRadiusBottomStart="@dimen/card_corner_small" app:boxCornerRadiusTopEnd="@dimen/card_corner_small" app:boxCornerRadiusTopStart="@dimen/card_corner_small">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/etChoiceB" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" />
</com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:gravity="center_vertical" android:orientation="horizontal">
<RadioButton android:id="@+id/radioC" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/primary" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_sm" android:layout_weight="1" android:hint="@string/hint_choice_c" app:boxCornerRadiusBottomEnd="@dimen/card_corner_small" app:boxCornerRadiusBottomStart="@dimen/card_corner_small" app:boxCornerRadiusTopEnd="@dimen/card_corner_small" app:boxCornerRadiusTopStart="@dimen/card_corner_small">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/etChoiceC" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" />
</com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:gravity="center_vertical" android:orientation="horizontal">
<RadioButton android:id="@+id/radioD" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/primary" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_sm" android:layout_weight="1" android:hint="@string/hint_choice_d" app:boxCornerRadiusBottomEnd="@dimen/card_corner_small" app:boxCornerRadiusBottomStart="@dimen/card_corner_small" app:boxCornerRadiusTopEnd="@dimen/card_corner_small" app:boxCornerRadiusTopStart="@dimen/card_corner_small">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/etChoiceD" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" />
</com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<TextView android:id="@+id/tvCorrectAnswerLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:text="@string/label_correct_answer" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:id="@+id/cardIdentification" style="@style/Card.Standard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_xl">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_xs" android:text="Correct Answer" android:textColor="@color/text_primary" android:textSize="@dimen/text_title_small" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_md" android:text="Student answers will be matched case-insensitively" android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption" />
<com.google.android.material.textfield.TextInputLayout android:id="@+id/tilAnswerText" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/hint_correct_answer_identification" app:boxCornerRadiusBottomEnd="@dimen/input_corner" app:boxCornerRadiusBottomStart="@dimen/input_corner" app:boxCornerRadiusTopEnd="@dimen/input_corner" app:boxCornerRadiusTopStart="@dimen/input_corner">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/etAnswerText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" />
</com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.card.MaterialCardView android:id="@+id/cardEssay" style="@style/Card.Standard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/spacing_xl">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_xs" android:text="Model Answer (Optional)" android:textColor="@color/text_primary" android:textSize="@dimen/text_title_small" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/spacing_md" android:text="A reference answer for grading. Students will type their own response." android:textColor="@color/text_secondary" android:textSize="@dimen/text_caption" />
<com.google.android.material.textfield.TextInputLayout android:id="@+id/tilModelAnswer" style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/hint_model_answer_essay" app:boxCornerRadiusBottomEnd="@dimen/input_corner" app:boxCornerRadiusBottomStart="@dimen/input_corner" app:boxCornerRadiusTopEnd="@dimen/input_corner" app:boxCornerRadiusTopStart="@dimen/input_corner">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/etModelAnswer" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:inputType="textMultiLine" android:minLines="3" />
</com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_md" android:text="@string/label_needs_manual_grading" android:textColor="@color/warning" android:textSize="@dimen/text_caption" />
</LinearLayout>
</com.google.android.material.card.MaterialCardView>
<com.google.android.material.button.MaterialButton android:id="@+id/btnSave" style="@style/Button.PrimaryTall" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xxl" android:text="@string/btn_save_question" />
<ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="@dimen/spacing_lg" android:visibility="gone" />
</LinearLayout>
</ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
