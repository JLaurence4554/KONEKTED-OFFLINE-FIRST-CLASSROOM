<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/header_gradient_start"
                android:endColor="@color/header_gradient_end"
                android:angle="135" />
            <corners
                android:bottomLeftRadius="@dimen/header_corner_radius"
                android:bottomRightRadius="@dimen/header_corner_radius" />
        </shape>
    </item>
    <item
        android:left="200dp"
        android:top="-40dp">
        <shape android:shape="oval">
            <solid android:color="#15FFFFFF" />
            <size
                android:width="200dp"
                android:height="200dp" />
        </shape>
    </item>
    <item
        android:left="-60dp"
        android:bottom="-30dp">
        <shape android:shape="oval">
            <solid android:color="#10FFFFFF" />
            <size
                android:width="160dp"
                android:height="160dp" />
        </shape>
    </item>
</layer-list>
