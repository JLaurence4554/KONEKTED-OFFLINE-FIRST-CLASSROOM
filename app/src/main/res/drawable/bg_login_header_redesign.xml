<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/header_primary" />
        </shape>
    </item>
    <item android:left="180dp" android:top="-60dp">
        <shape android:shape="oval">
            <solid android:color="#18FFFFFF" />
            <size android:width="260dp" android:height="260dp" />
        </shape>
    </item>
    <item android:right="-40dp" android:bottom="-40dp">
        <shape android:shape="oval">
            <solid android:color="#12FFFFFF" />
            <size android:width="140dp" android:height="140dp" />
        </shape>
    </item>
</layer-list>
